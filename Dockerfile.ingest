# The daily ingestion Lambda. Both stages use the Lambda base image, so dependencies
# are installed against the same Python and glibc they run on: a venv built on the
# Debian images the other two Dockerfiles use would not load here.
FROM --platform=linux/arm64 public.ecr.aws/lambda/python:3.14 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
# Lambda loads code from a flat directory, not a venv, so install into one.
RUN uv export --frozen --no-default-groups --no-hashes --no-emit-project -o requirements.txt \
 && uv pip install --python /var/lang/bin/python3 --target /asset -r requirements.txt \
 && uv pip install --python /var/lang/bin/python3 --target /asset --no-deps .

FROM --platform=linux/arm64 public.ecr.aws/lambda/python:3.14

COPY --from=builder /asset ${LAMBDA_TASK_ROOT}

CMD ["glia_nav.ingest.handler.handler"]
