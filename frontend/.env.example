# Copy to .env.local for local development. CI sets NEXT_PUBLIC_CHAT_API_URL at build time.
# NEXT_PUBLIC_CHAT_API_URL is the App Runner URL: /chat skips Amplify's /api rewrite,
# which times out at 30 s. Left empty, chat uses NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_API_URL is only needed locally; deployed, search calls the same-origin
# /api path that Amplify rewrites to App Runner.
NEXT_PUBLIC_CHAT_API_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
