# Copy to .env for local development. Never commit .env.
# Later phases add their variables here as they are introduced.

AWS_REGION=us-east-1

# Phase 2: Aurora Serverless v2. Both ARNs are CloudFormation outputs of DataStack.
# The cluster has no network route from outside the VPC; access is via the RDS Data
# API, authenticated with IAM. Nothing here is a secret.
DATABASE_CLUSTER_ARN=
DATABASE_SECRET_ARN=
DATABASE_NAME=glianav
DOCUMENTS_BUCKET=

# Phase 3: backend API.
LOG_LEVEL=INFO

# Phase 7: Cognito. Both are CloudFormation outputs of BackendStack. Not secrets:
# the same values ship in the frontend bundle.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Tokens the public demo's chat may bill per day (US Eastern) before /chat refuses.
DAILY_TOKEN_LIMIT=150000

# Phase 4: agent layer. MODEL_LARGE is Opus 4.6, the newest model this account can invoke.
# AGENT_RUNTIME_ARN and GATEWAY_URL are CloudFormation outputs of AgentStack.
MODEL_SMALL=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_LARGE=us.anthropic.claude-opus-4-6-v1
MAX_OUTPUT_TOKENS=4096
AGENT_RUNTIME_ARN=

# Phase 5: AgentCore Gateway MCP endpoint. IAM inbound auth, so no token goes here.
GATEWAY_URL=

# Phase 9: Bedrock Guardrail. Leave blank locally to run the agent unguarded.
GUARDRAIL_ID=
GUARDRAIL_VERSION=

# Ingestion. DOCUMENTS_BUCKET above receives the raw API payloads.
# NCBI_API_KEY is optional; it raises the E-utilities limit from 3 to 10 requests/second.
# Get one at https://account.ncbi.nlm.nih.gov/settings/. Deployed, it comes from Secrets Manager.
# Trial eligibility is extracted with MODEL_SMALL, set above.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
NCBI_API_KEY=

# Infra only: the address OpsStack subscribes to budget and alarm alerts. Export it before any
# cdk synth, diff, or deploy. CI reads it from the ALERT_EMAIL GitHub Actions secret.
ALERT_EMAIL=
